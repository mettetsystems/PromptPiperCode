# Prompt Piper — local development environment
# Copy to .env and adjust values as needed.

# --- Application ---
APP_NAME=Prompt Piper
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Use sqlite for early local dev, or postgres for full features (pgvector).
DATABASE_URL=sqlite:///./data/prompt_piper.db
# DATABASE_URL=postgresql+psycopg://prompt_piper:prompt_piper@localhost:5432/prompt_piper

# --- Paths (relative to repo root) ---
REGISTRY_PATH=./data/registry
ARTIFACTS_PATH=./data/artifacts

# --- Frontend (Vite dev server) ---
VITE_API_BASE_URL=http://localhost:8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
