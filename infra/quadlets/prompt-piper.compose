# Run the full PromptPiperCode stack via podman compose (recommended Quadlet method).
# Install: scripts/install-quadlets.sh --method compose
#
# Build images once before first start:
#   podman compose -f infra/podman-compose.yml build

[Unit]
Description=PromptPiperCode (Podman Compose stack)
Documentation=file://%h/PromptPiperCode/infra/quadlets/README.md
After=network-online.target
Wants=network-online.target

[Compose]
File=%h/PromptPiperCode/infra/podman-compose.yml
WorkingDirectory=%h/PromptPiperCode

[Service]
Restart=always

[Install]
WantedBy=default.target
